{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Who Takes In Victoria's Lost and Surrendered Pets? (2025)",
    "subtitle": "Each square is 1% of the 75,440 dog and cat admissions reported",
    "fontSize": 16,
    "anchor": "middle"
  },
  "width": 300,
  "height": 300,
  "data": {
    "url": "https://raw.githubusercontent.com/bczm-monash/FIT3179-Assignment-2/main/2025-animal-fate-data-set-for-publication.csv"
  },
  "transform": [
    {
      "fold": [
        "Number of instances in which animals were admitted to the establishment\\'s care in the reporting period Dogs",
        "Number of instances in which animals were admitted to the establishment\\'s care in the reporting period Cats"
      ],
      "as": [
        "key",
        "value"
      ]
    },
    {
      "filter": "isValid(datum.value)"
    },
    {
      "calculate": "indexof(datum['Trading name'], 'Lost Dogs Home') >= 0 ? 'Lost Dogs Home' : indexof(datum['Trading name'], 'RSPCA') >= 0 ? 'RSPCA' : (indexof(datum['Trading name'], 'Council') >= 0 || indexof(datum['Trading name'], 'Shire') >= 0 || indexof(datum['Trading name'], 'City of') >= 0) ? 'Council pounds' : 'Other shelters and facilities'",
      "as": "group"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "value",
          "as": "admissions"
        }
      ],
      "groupby": [
        "group"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "admissions",
          "as": "total"
        }
      ]
    },
    {
      "calculate": "datum.admissions / datum.total",
      "as": "share"
    },
    {
      "calculate": "indexof([\"Lost Dogs Home\", \"Council pounds\", \"Other shelters and facilities\", \"RSPCA\"], datum.group)",
      "as": "ord"
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "share",
          "as": "cum"
        }
      ],
      "sort": [
        {
          "field": "ord"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "calculate": "round((datum.cum - datum.share) * 100)",
      "as": "startCell"
    },
    {
      "calculate": "round(datum.cum * 100)",
      "as": "endCell"
    },
    {
      "calculate": "sequence(datum.startCell, datum.endCell)",
      "as": "cells"
    },
    {
      "flatten": [
        "cells"
      ],
      "as": [
        "cell"
      ]
    },
    {
      "calculate": "datum.cell % 10",
      "as": "col"
    },
    {
      "calculate": "floor(datum.cell / 10)",
      "as": "row"
    }
  ],
  "mark": {
    "type": "square",
    "size": 700,
    "opacity": 1
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "title": "Who admitted the animals",
      "scale": {
        "domain": [
          "Lost Dogs Home",
          "Council pounds",
          "Other shelters and facilities",
          "RSPCA"
        ],
        "range": [
          "#c4572a",
          "#4c78a8",
          "#59a14f",
          "#f2b134"
        ]
      },
      "legend": {
        "labelFontSize": 12,
        "titleFontSize": 12,
        "orient": "right"
      }
    },
    "tooltip": [
      {
        "field": "group",
        "title": "Facility group"
      },
      {
        "field": "admissions",
        "type": "quantitative",
        "title": "Admissions",
        "format": ","
      },
      {
        "field": "share",
        "type": "quantitative",
        "title": "Share",
        "format": ".1%"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}
