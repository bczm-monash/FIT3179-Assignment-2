{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Share of Dogs and Cats Euthanased by State (2024-2025)",
  "width": 360,
  "height": 300,
  "data": {
    "url": "https://raw.githubusercontent.com/bczm-monash/FIT3179-Assignment-2/main/rspca_national_statistics_2024_2025.csv"
  },
  "transform": [
    {
      "filter": "datum.section == 'State animal outcomes'"
    },
    {
      "filter": "datum.animal_type == 'Dogs' || datum.animal_type == 'Cats'"
    },
    {
      "filter": "datum.metric == 'Euthanased' || datum.metric == 'Total Received'"
    },
    {
      "pivot": "metric",
      "value": "value",
      "groupby": [
        "geography"
      ],
      "op": "sum"
    },
    {
      "calculate": "datum.Euthanased / datum['Total Received']",
      "as": "share"
    },
    {
      "calculate": "{'NT':1,'QLD':3,'WA':0,'SA':1,'NSW':3,'ACT':4,'VIC':3,'TAS':3}[datum.geography]",
      "as": "col"
    },
    {
      "calculate": "{'NT':0,'QLD':0,'WA':1,'SA':1,'NSW':1,'ACT':1,'VIC':2,'TAS':3}[datum.geography]",
      "as": "row"
    },
    {
      "filter": "isValid(datum.col)"
    }
  ],
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 3
      },
      "encoding": {
        "color": {
          "field": "share",
          "type": "quantitative",
          "title": "Share Euthanased",
          "scale": {
            "scheme": "oranges"
          },
          "legend": {
            "format": ".0%"
          }
        },
        "tooltip": [
          {
            "field": "geography",
            "title": "State"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Share",
            "format": ".1%"
          },
          {
            "field": "Euthanased",
            "type": "quantitative",
            "title": "Euthanased",
            "format": ","
          },
          {
            "field": "Total Received",
            "type": "quantitative",
            "title": "Received",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -6,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "geography"
        },
        "color": {
          "condition": {
            "test": "datum.share > 0.15",
            "value": "white"
          },
          "value": "#2b2b2b"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": 10,
        "fontSize": 11
      },
      "encoding": {
        "text": {
          "field": "share",
          "type": "quantitative",
          "format": ".0%"
        },
        "color": {
          "condition": {
            "test": "datum.share > 0.15",
            "value": "white"
          },
          "value": "#2b2b2b"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
