            ]
          }
        },
        {
          "calculate": "datum.lon + datum.dlon",
          "as": "lonL"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "dy": 8
      },
      "encoding": {
        "longitude": {
          "field": "lonL",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
