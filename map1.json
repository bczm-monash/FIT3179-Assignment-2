{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 400,
  "title": "Total RSPCA Animal Intakes by State (2024-2025)",
  "data": {
    "url": "rspca_national_statistics_2024_2025.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "filter": "datum.metric == 'Total Received' && datum.animal_type == 'All animals' && datum.geography != 'Australia'"
    },
    {
      "lookup": "geography",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
          "format": {"type": "json", "property": "features"}
        },
        "key": "properties.STATE_NAME",
        "fields": ["type", "geometry"]
      }
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1
  },
  "encoding": {
    "shape": {
      "field": "geometry",
      "type": "geojson"
    },
    "color": {
      "field": "value",
      "type": "quantitative",
      "title": "Total Animals Received",
      "scale": {"scheme": "oranges"}
    },
    "tooltip": [
      {"field": "geography", "type": "nominal", "title": "State/Territory"},
      {"field": "value", "type": "quantitative", "title": "Total Intakes", "format": ","}
    ]
  }
}
