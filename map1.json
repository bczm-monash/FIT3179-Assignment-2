{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Total RSPCA Animal Intakes by State (2024-2025)",
  "width": 700,
  "height": 500,
  "data": {
    "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/australian-states.json",
    "format": { "type": "geojson" }
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "values": [
            { "State": "New South Wales", "Intakes": 25000 },
            { "State": "Victoria", "Intakes": 18000 },
            { "State": "Queensland", "Intakes": 22000 },
            { "State": "South Australia", "Intakes": 9000 },
            { "State": "Western Australia", "Intakes": 11000 },
            { "State": "Tasmania", "Intakes": 4000 },
            { "State": "Northern Territory", "Intakes": 2000 },
            { "State": "Australian Capital Territory", "Intakes": 3000 }
          ]
        },
        "key": "State",
        "fields": ["Intakes"]
      }
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "mark": "geoshape",
  "encoding": {
    "color": {
      "field": "Intakes",
      "type": "quantitative",
      "scale": { "scheme": "oranges" },
      "title": "Total Animals Received"
    },
    "tooltip": [
      { "field": "properties.STATE_NAME", "type": "nominal", "title": "State" },
      { "field": "Intakes", "type": "quantitative", "title": "Intakes" }
    ]
  }
}
