{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 400,
  "title": "Total RSPCA Animal Intakes by State (2024-2025)",
  "data": {
    "url": "states.topojson",
    "format": {"type": "topojson", "feature": "states"}
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "rspca_national_statistics_2024_2025.csv"
        },
        "key": "geography",
        "fields": ["value"]
      }
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1
  },
  "encoding": {
    "color": {
      "field": "value",
      "type": "quantitative",
      "title": "Total Animals Received",
      "scale": {"scheme": "oranges"}
    },
    "tooltip": [
      {"field": "properties.STATE_NAME", "type": "nominal", "title": "State"},
      {"field": "value", "type": "quantitative", "title": "Total Intakes", "format": ","}
    ]
  }
}
