{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 450,
  "title": "Global Population Estimate by Country",
  "projection": {
    "type": "equalEarth"
  },
  "data": {
    "url": "ne_110m.json",
    "format": {
      "type": "topojson",
      "feature": "ne_110m_admin_0_countries"
    }
  },
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 0.5
  },
  "encoding": {
    "color": {
      "field": "properties.POP_EST",
      "type": "quantitative",
      "title": "Population Estimate",
      "scale": {
        "type": "log",
        "scheme": "blues"
      }
    },
    "tooltip": [
      {"field": "properties.NAME", "type": "nominal", "title": "Country"},
      {"field": "properties.POP_EST", "type": "quantitative", "title": "Population", "format": ","}
    ]
  }
}
